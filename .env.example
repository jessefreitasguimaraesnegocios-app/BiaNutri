# Copie para .env e preencha os valores.
# Supabase (obrigatório)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# Opcional: Mercado Pago (pagamento com cartão no app)
# VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-xxx

# Admin: e-mails com acesso total (sem pagamento e sem trial), separados por vírgula
# Exemplo: VITE_ADMIN_EMAILS=admin@seudominio.com,outro@email.com
VITE_ADMIN_EMAILS=
